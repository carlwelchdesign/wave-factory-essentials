#pragma once
#include <algorithm>
#include <cmath>

namespace @internal_name@_dsp {
// Header-only reference DSP. No dependency on the adapter, graphics, or host.
class GainProcessor {
 public:
  void Prepare(double sampleRate, double gainDb = 0., bool bypass = false) {
    coefficient_ = std::exp(-1. / (0.01 * std::max(1., sampleRate)));
    SetParameters(gainDb, bypass);
    current_ = target_;
  }
  void SetParameters(double gainDb, bool bypass) {
    const double bounded = std::isfinite(gainDb) ? std::clamp(gainDb, -60., 12.) : 0.;
    target_ = bypass ? 1. : std::pow(10., bounded / 20.);
  }
  template <class Sample>
  void Process(Sample** inputs, Sample** outputs, int channels, int frames) {
    for (int frame = 0; frame < frames; ++frame) {
      current_ = target_ + coefficient_ * (current_ - target_);
      for (int channel = 0; channel < channels; ++channel)
        outputs[channel][frame] = static_cast<Sample>(inputs[channel][frame] * current_);
    }
  }
 private:
  double current_ = 1.;
  double target_ = 1.;
  double coefficient_ = 0.;
};
}
