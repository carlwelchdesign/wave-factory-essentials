# Starter @starter_version@. Owned product code after generation.
if(BUILD_TESTING)
  add_executable(@internal_name@-dsp-tests gain_tests.cpp)
  add_dependencies(wfe-starter-checks @internal_name@-dsp-tests)
  add_test(NAME @internal_name@-dsp COMMAND @internal_name@-dsp-tests)
endif()
if(WFE_BUILD_PLUGINS)
  file(GLOB_RECURSE plugin_assets CONFIGURE_DEPENDS "resources/img/*.png" "resources/fonts/*.ttf")
  set(asset_names "")
  foreach(asset IN LISTS plugin_assets)
    get_filename_component(asset_name "${asset}" NAME)
    if(asset_name IN_LIST asset_names)
      message(FATAL_ERROR "Duplicate resource basename: ${asset_name}")
    endif()
    list(APPEND asset_names "${asset_name}")
  endforeach()
  iplug_add_plugin(@internal_name@
    SOURCES @internal_name@.cpp @internal_name@.h GainProcessor.h resources/resource.h
    RESOURCES ${plugin_assets}
    FORMATS AU VST3 CLAP)
  if(WIN32)
    # Build Windows and macOS resource lists from the same asset set.
    set(rc_text "#include \"${CMAKE_CURRENT_SOURCE_DIR}/resources/resource.h\"\n")
    foreach(asset IN LISTS plugin_assets)
      get_filename_component(asset_name "${asset}" NAME)
      get_filename_component(extension "${asset}" EXT)
      if(extension STREQUAL ".png")
        set(kind PNG)
      else()
        set(kind TTF)
      endif()
      string(APPEND rc_text "\"${asset_name}\" ${kind} \"${asset}\"\n")
    endforeach()
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/main.rc" "${rc_text}")
    foreach(format vst3 clap)
      target_sources(@internal_name@-${format} PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/main.rc")
    endforeach()
  endif()
  foreach(format au vst3 clap)
    if(TARGET @internal_name@-${format})
      add_dependencies(wfe-generated-plugins @internal_name@-${format})
    endif()
  endforeach()
endif()
